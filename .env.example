# Copy to .env for local development.
#
# Generate the key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Never commit the real .env — it is gitignored. In production these come from
# the platform's secret store, not a file.

SECRET_KEY=replace-me-with-a-generated-value
ENVIRONMENT=development

# Optional. Defaults to a local SQLite file outside production, where it is
# required so a container can never silently use an ephemeral database.
# DATABASE_URL=postgresql+psycopg://expense:password@localhost:5432/expense_tracker

# Optional. Defaults to the local dev ports; required in production.
# ALLOWED_ORIGINS=https://expenses.example.com
